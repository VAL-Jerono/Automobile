# MySQL Database Configuration
# Copy this to .env and fill in your actual values

# Database Host (localhost for local, your-host.com for cloud)
MYSQL_HOST=localhost

# Database Port (default: 3306)
MYSQL_PORT=3306

# Database User (create dedicated user for security)
MYSQL_USER=insurance_user

# Database Password (use strong password in production)
MYSQL_PASSWORD=your_secure_password_here

# Database Name
MYSQL_DATABASE=insurance

# ============================================
# Streamlit App Configuration
# ============================================

# Server port for Streamlit
STREAMLIT_PORT=8501

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# Development vs Production
# ============================================

# Set to 'development' or 'production'
ENVIRONMENT=development

# ============================================
# Optional: API Configuration
# ============================================

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False

# ============================================
# Notes:
# - This file should NOT be committed to git
# - Create actual .env file with real credentials
# - Never share production passwords
# - Use strong passwords (16+ chars, mixed case, numbers, symbols)
# ============================================
